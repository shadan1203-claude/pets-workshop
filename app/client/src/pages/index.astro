---
import Layout from '../layouts/Layout.astro';
import DogList from '../components/DogList.astro';

const API_SERVER_URL = process.env.API_SERVER_URL || 'http://localhost:5100';
const PAGE_SIZE = 6;

let dogs = [];
let breeds = [];
let page = 1;
let totalPages = 1;
let total = 0;
let error: string | null = null;

const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const selectedBreed = Astro.url.searchParams.get('breed') || '';
const query = new URLSearchParams({ page: String(currentPage), per_page: String(PAGE_SIZE) });
if (selectedBreed) {
  query.set('breed', selectedBreed);
}

try {
  const [dogsResponse, breedsResponse] = await Promise.all([
    fetch(`${API_SERVER_URL}/api/dogs?${query.toString()}`),
    fetch(`${API_SERVER_URL}/api/breeds`),
  ]);

  if (dogsResponse.ok) {
    const data = await dogsResponse.json();
    dogs = data.dogs;
    page = data.page;
    totalPages = data.total_pages;
    total = data.total;
  } else {
    error = `Failed to fetch dog data: ${dogsResponse.status} ${dogsResponse.statusText}`;
  }

  if (breedsResponse.ok) {
    breeds = await breedsResponse.json();
  } else if (!error) {
    error = `Failed to fetch breed data: ${breedsResponse.status} ${breedsResponse.statusText}`;
  }
} catch (err) {
  error = `Error: ${err instanceof Error ? err.message : String(err)}`;
}
---

<Layout title="Tailspin Shelter - Find Your Forever Friend">
  <div class="py-8">
    <div class="max-w-3xl mb-10">
      <h1 class="text-4xl font-bold mb-4 text-slate-100">Welcome to Tailspin Shelter</h1>
      <p class="text-xl text-slate-300">Find your perfect companion from our wonderful selection of dogs looking for their forever homes.</p>
    </div>

    {error ? (
      <div class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700" data-testid="error-message">
        <p class="text-red-400">{error}</p>
      </div>
    ) : (
      <>
        <form method="get" class="mb-8 flex flex-wrap items-center gap-3" data-testid="breed-filter-form">
          <label for="breed" class="text-sm font-medium text-slate-300">Breed</label>
          <input type="hidden" name="page" value="1" />
          <select
            id="breed"
            name="breed"
            class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none"
            data-testid="breed-select"
            onchange="if (!this.value) this.removeAttribute('name'); else this.setAttribute('name', 'breed'); this.form.submit()"
          >
            <option value="">All breeds</option>
            {breeds.map((breed) => (
              <option value={breed.name} selected={selectedBreed.toLowerCase() === breed.name.toLowerCase()}>{breed.name}</option>
            ))}
          </select>
        </form>

        <DogList dogs={dogs} total={total} breed={selectedBreed} />

        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-10" data-testid="pagination">
            {page > 1 ? (
              <a
                href={`/?page=${page - 1}${selectedBreed ? `&breed=${encodeURIComponent(selectedBreed)}` : ''}`}
                class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
                data-testid="pagination-prev"
              >
                ← Previous
              </a>
            ) : (
              <span class="px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-600 cursor-not-allowed">
                ← Previous
              </span>
            )}

            <span class="px-4 py-2 text-slate-300" data-testid="pagination-info">
              Page {page} of {totalPages}
            </span>

            {page < totalPages ? (
              <a
                href={`/?page=${page + 1}${selectedBreed ? `&breed=${encodeURIComponent(selectedBreed)}` : ''}`}
                class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
                data-testid="pagination-next"
              >
                Next →
              </a>
            ) : (
              <span class="px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-600 cursor-not-allowed">
                Next →
              </span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</Layout>
