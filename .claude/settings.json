{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "pets-workshop-orchestrator",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run build)",
      "Bash(npm test)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(npm run deploy *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(terraform *)",
      "Bash(az deployment *)",
      "Bash(gcloud *)",
      "Bash(docker *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(gh *)",
      "PowerShell(npm run deploy *)",
      "PowerShell(kubectl *)",
      "PowerShell(helm *)",
      "PowerShell(terraform *)",
      "PowerShell(az deployment *)",
      "PowerShell(gcloud *)",
      "PowerShell(docker *)",
      "mcp__jira__*",
      "mcp__confluence__*",
      "mcp__github__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fd *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "enabledMcpjsonServers": [
    "jira",
    "confluence",
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/load-workflow-state.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/gate-guard.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-commit.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-pr.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-commit.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "if": "PowerShell(gh pr create *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/pre-pr.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/post-edit-check.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
